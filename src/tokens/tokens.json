    "1":   { "$value": "4px",  "$type": "dimension" },
    "1.5": { "$value": "6px",  "$type": "dimension" },
    "2":   { "$value": "8px",  "$type": "dimension" },
    "2.5": { "$value": "10px", "$type": "dimension" },
    "3":   { "$value": "12px", "$type": "dimension" },
    "4":   { "$value": "16px", "$type": "dimension" },
    "5":   { "$value": "20px", "$type": "dimension" },
    "6":   { "$value": "24px", "$type": "dimension" },
    "7":   { "$value": "28px", "$type": "dimension" },
    "8":   { "$value": "32px", "$type": "dimension" },
    "10":  { "$value": "40px", "$type": "dimension" },
    "12":  { "$value": "48px", "$type": "dimension" },
    "14":  { "$value": "56px", "$type": "dimension" },
    "16":  { "$value": "64px", "$type": "dimension" },
    "18":  { "$value": "72px", "$type": "dimension" },
    "20":  { "$value": "80px", "$type": "dimension" },
    "24":  { "$value": "96px", "$type": "dimension" },
    "28":  { "$value": "112px","$type": "dimension" },
    "32":  { "$value": "128px","$type": "dimension" }
  },

  "borderRadius": {
    "none":   { "$value": "0",      "$type": "borderRadius" },
    "xs":     { "$value": "5px",    "$type": "borderRadius", "$description": "Inline code, micro badges" },
    "sm":     { "$value": "6px",    "$type": "borderRadius", "$description": "Anchor chips, small tags" },
    "md":     { "$value": "8px",    "$type": "borderRadius", "$description": "Small buttons, compact elements" },
    "btn":    { "$value": "10px",   "$type": "borderRadius", "$description": "Standard button, input, select" },
    "card-sm":{ "$value": "12px",   "$type": "borderRadius", "$description": "Quiz option cards, dropdowns" },
    "card":   { "$value": "14px",   "$type": "borderRadius", "$description": "Feature cards, table" },
    "card-lg":{ "$value": "16px",   "$type": "borderRadius", "$description": "Service cards, step cards, canvas" },
    "xl":     { "$value": "20px",   "$type": "borderRadius", "$description": "AI/CTA banners" },
    "modal":  { "$value": "24px",   "$type": "borderRadius", "$description": "QuizModal corners" },
    "pill":   { "$value": "100px",  "$type": "borderRadius", "$description": "FloatingQuizBtn, badge, toggle track" },
    "full":   { "$value": "9999px", "$type": "borderRadius", "$description": "Circles, status dots" }
  },

