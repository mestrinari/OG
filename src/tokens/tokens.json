{
  "$metadata": {
    "name": "OG Labs Design Tokens",
    "version": "1.0.0",
    "description": "Token library for OG Labs — compatible with Tokens Studio for Figma (W3C DTCG format)",
    "updatedAt": "2026-07-12"
  },

  "color": {
    "$description": "Color palette for OG Labs product",

    "navy": {
      "950": { "$value": "#0c1445", "$type": "color", "$description": "Foreground, body text, dark section backgrounds" },
      "900": { "$value": "#0f2050", "$type": "color", "$description": "Hero Home mid-stop" },
      "850": { "$value": "#0a1930", "$type": "color", "$description": "Hero Home darkest stop" }
    },

    "blue": {
      "800": { "$value": "#1e3a8a", "$type": "color", "$description": "Web page accent, hero gradients" },
      "700": { "$value": "#1d4ed8", "$type": "color", "$description": "Primary — buttons, links" },
      "600": { "$value": "#2563eb", "$type": "color", "$description": "Ring, focus outline, eyebrow labels" },
      "400": { "$value": "#60a5fa", "$type": "color", "$description": "Light labels on dark backgrounds" },
      "100": { "$value": "#dbeafe", "$type": "color", "$description": "Badge background, muted surfaces" },
      "50":  { "$value": "#eff6ff", "$type": "color", "$description": "Hover tints, very light tints" }
    },

    "cyan": {
      "700": { "$value": "#0e7490", "$type": "color", "$description": "Mobile page — dark stop" },
      "600": { "$value": "#0891b2", "$type": "color", "$description": "Accent — Mobile page, progress bar end" },
      "500": { "$value": "#06b6d4", "$type": "color", "$description": "Cyan mid" },
      "100": { "$value": "#cffafe", "$type": "color", "$description": "Mobile badge background" }
    },

    "amber": {
      "600": { "$value": "#d97706", "$type": "color", "$description": "Quiz button dark stop" },
      "500": { "$value": "#f59e0b", "$type": "color", "$description": "Quiz button base — FloatingQuizBtn" },
      "200": { "$value": "#fde68a", "$type": "color", "$description": "Amber light" },
      "100": { "$value": "#fef3c7", "$type": "color", "$description": "Badge background amber" },
      "50":  { "$value": "#fffbeb", "$type": "color", "$description": "Alert warning background" }
    },

    "green": {
      "800": { "$value": "#15803d", "$type": "color", "$description": "WhatsApp button dark" },
      "700": { "$value": "#047857", "$type": "color", "$description": "Local Systems dark stop" },
      "600": { "$value": "#16a34a", "$type": "color", "$description": "WhatsApp button, Success states" },
      "500": { "$value": "#059669", "$type": "color", "$description": "Local Systems — Sistemas Locais page" },
      "100": { "$value": "#dcfce7", "$type": "color", "$description": "Success badge background" },
      "50":  { "$value": "#f0fdf4", "$type": "color", "$description": "Alert success background" }
    },

    "purple": {
      "700": { "$value": "#6d28d9", "$type": "color", "$description": "Software page dark stop" },
      "600": { "$value": "#7c3aed", "$type": "color", "$description": "Software page — Softwares page" },
      "800": { "$value": "#1e1040", "$type": "color", "$description": "Software hero dark navy" },
      "100": { "$value": "#ede9fe", "$type": "color", "$description": "Purple badge background" }
    },

    "red": {
      "700": { "$value": "#b91c1c", "$type": "color", "$description": "Danger button dark" },
      "600": { "$value": "#dc2626", "$type": "color", "$description": "Error state, Danger button, Destructive" },
      "100": { "$value": "#fee2e2", "$type": "color", "$description": "Error badge background" },
      "50":  { "$value": "#fef2f2", "$type": "color", "$description": "Alert error background" }
    },

    "gray": {
      "500": { "$value": "#717182", "$type": "color", "$description": "Muted text, table headers" },
      "400": { "$value": "#9ca3af", "$type": "color", "$description": "Placeholder text, captions" },
      "300": { "$value": "#d1d5db", "$type": "color", "$description": "Inactive borders (toggles, checkboxes)" },
      "200": { "$value": "#e5e7eb", "$type": "color", "$description": "Disabled input borders" },
      "100": { "$value": "#f3f4f6", "$type": "color", "$description": "Gray badge background" }
    },

    "semantic": {
      "background":          { "$value": "#f7f9ff", "$type": "color", "$description": "Page background — CSS var --background" },
      "foreground":          { "$value": "#0c1445", "$type": "color", "$description": "Default text — CSS var --foreground" },
      "card":                { "$value": "#ffffff", "$type": "color", "$description": "Card background — CSS var --card" },
      "cardForeground":      { "$value": "#0c1445", "$type": "color", "$description": "Card text" },
      "primary":             { "$value": "#1d4ed8", "$type": "color", "$description": "Primary brand — CSS var --primary" },
      "primaryForeground":   { "$value": "#ffffff", "$type": "color", "$description": "Text on primary" },
      "secondary":           { "$value": "#e2eaff", "$type": "color", "$description": "Secondary surface — CSS var --secondary" },
      "secondaryForeground": { "$value": "#0c1445", "$type": "color", "$description": "Text on secondary" },
      "muted":               { "$value": "#e2eaff", "$type": "color", "$description": "Muted surface — CSS var --muted" },
      "mutedForeground":     { "$value": "#4b5684", "$type": "color", "$description": "Muted text — CSS var --muted-foreground" },
      "accent":              { "$value": "#0891b2", "$type": "color", "$description": "Accent highlight — CSS var --accent" },
      "accentForeground":    { "$value": "#ffffff", "$type": "color", "$description": "Text on accent" },
      "border":              { "$value": "rgba(29,78,216,0.12)", "$type": "color", "$description": "Hairline borders — CSS var --border" },
      "ring":                { "$value": "#2563eb", "$type": "color", "$description": "Focus ring — CSS var --ring" },
      "destructive":         { "$value": "#dc2626", "$type": "color", "$description": "Destructive actions — CSS var --destructive" }
    },

    "page": {
      "$description": "Per-page thematic identity colors used for Navbar and Hero sections",
      "home":    { "$value": "#0c1445", "$type": "color", "$description": "/ — Home page identity" },
      "web":     { "$value": "#1e3a8a", "$type": "color", "$description": "/web — Web Systems page identity" },
      "mobile":  { "$value": "#0e7490", "$type": "color", "$description": "/mobile — Mobile page identity" },
      "software":{ "$value": "#5b21b6", "$type": "color", "$description": "/software — Software page identity" },
      "local":   { "$value": "#059669", "$type": "color", "$description": "/sistemas-locais — Local Systems identity" }
    },

    "status": {
      "online": { "$value": "#22c55e", "$type": "color", "$description": "Online status dot" },
      "away":   { "$value": "#f59e0b", "$type": "color", "$description": "Away status dot" },
      "busy":   { "$value": "#dc2626", "$type": "color", "$description": "Busy status dot" },
      "offline":{ "$value": "#9ca3af", "$type": "color", "$description": "Offline status dot" }
    }
  },

  "gradient": {
    "$description": "All gradients used in the OG Labs product — stored as CSS linear-gradient strings",

    "hero-home":     { "$value": "linear-gradient(160deg, #0c1445 0%, #0f2050 50%, #0a1930 100%)", "$type": "other", "$description": "/ Home hero — also Navbar default" },
    "hero-web":      { "$value": "linear-gradient(160deg, #0c1445 0%, #1e3a8a 100%)",              "$type": "other", "$description": "/web Hero, StyleGuide header, AI banners" },
    "hero-mobile":   { "$value": "linear-gradient(160deg, #0a1930 0%, #0e7490 100%)",              "$type": "other", "$description": "/mobile Hero and Navbar" },
    "hero-software": { "$value": "linear-gradient(160deg, #1e1040 0%, #5b21b6 100%)",              "$type": "other", "$description": "/software Hero and Navbar" },
    "hero-local":    { "$value": "linear-gradient(160deg, #042c1e 0%, #059669 100%)",              "$type": "other", "$description": "/sistemas-locais Hero and Navbar" },

    "btn-primary":   { "$value": "linear-gradient(135deg, #2563eb, #1d4ed8)", "$type": "other", "$description": "Primary button background" },
    "btn-cyan":      { "$value": "linear-gradient(135deg, #0891b2, #0e7490)", "$type": "other", "$description": "Cyan button — Mobile pages" },
    "btn-amber":     { "$value": "linear-gradient(135deg, #f59e0b, #d97706)", "$type": "other", "$description": "Amber button — Quiz / Orçamento (3 entry points)" },
    "btn-green":     { "$value": "linear-gradient(135deg, #16a34a, #15803d)", "$type": "other", "$description": "Green button — WhatsApp CTA" },
    "btn-danger":    { "$value": "linear-gradient(135deg, #dc2626, #b91c1c)", "$type": "other", "$description": "Danger/Destructive button" },

    "progress":      { "$value": "linear-gradient(90deg, #2563eb, #0891b2)",  "$type": "other", "$description": "ProgressBar fill, charts" },
    "logo":          { "$value": "linear-gradient(135deg, #2563eb, #0891b2)", "$type": "other", "$description": "LogoIcon, BrandIcon footer (default mode)" },
    "logo-dev":      { "$value": "linear-gradient(135deg, rgba(230,50,200,0.14), rgba(226,105,248,0.5))", "$type": "other", "$description": "LogoIcon in dev/dropdown mode" },
    "cta-dark":      { "$value": "linear-gradient(135deg, #0c1445, #1e3a8a)", "$type": "other", "$description": "CTA banner, AI banner, price card" },

    "card-software": { "$value": "linear-gradient(135deg, #7c3aed, #6d28d9)", "$type": "other", "$description": "Software card icon backgrounds" },
    "card-local":    { "$value": "linear-gradient(135deg, #059669, #047857)", "$type": "other", "$description": "Local Systems card icon backgrounds" }
  },

  "typography": {
    "$description": "Type system for OG Labs — Plus Jakarta Sans (display) + Inter (body) + JetBrains Mono (code)",

    "fontFamily": {
      "display": { "$value": "Plus Jakarta Sans", "$type": "fontFamily", "$description": "Headings, titles, buttons, logo — Google Fonts" },
      "body":     { "$value": "Inter",             "$type": "fontFamily", "$description": "Body text, labels, UI copy — Google Fonts" },
      "mono":     { "$value": "JetBrains Mono",   "$type": "fontFamily", "$description": "Code blocks, monospaced values — Google Fonts" }
    },

    "fontWeight": {
      "regular":   { "$value": 400, "$type": "fontWeight" },
      "medium":    { "$value": 500, "$type": "fontWeight" },
      "semibold":  { "$value": 600, "$type": "fontWeight" },
      "bold":      { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    },

    "fontSize": {
      "micro":    { "$value": "10.88px", "$type": "fontSize", "$description": "0.68rem — micro labels, badge text small" },
      "label":    { "$value": "11.52px", "$type": "fontSize", "$description": "0.72rem — uppercase labels, eyebrows, tags" },
      "caption":  { "$value": "12.48px", "$type": "fontSize", "$description": "0.78rem — captions, helper text, table mono" },
      "xs":       { "$value": "12.8px",  "$type": "fontSize", "$description": "0.80rem — StepNum, small chips" },
      "sm":       { "$value": "13.6px",  "$type": "fontSize", "$description": "0.85rem — card body text" },
      "body-s":   { "$value": "14.4px",  "$type": "fontSize", "$description": "0.90rem — QuizModal text, muted copy" },
      "body":     { "$value": "16px",    "$type": "fontSize", "$description": "1rem — default body" },
      "body-l":   { "$value": "18px",    "$type": "fontSize", "$description": "1.125rem — section subtitles" },
      "md":       { "$value": "20px",    "$type": "fontSize", "$description": "1.25rem — card headings, strong UI" },
      "lg":       { "$value": "24px",    "$type": "fontSize", "$description": "1.5rem — result titles, section sub-heads" },
      "xl":       { "$value": "28px",    "$type": "fontSize", "$description": "1.75rem" },
      "2xl":      { "$value": "36px",    "$type": "fontSize", "$description": "2.25rem — H2 section titles" },
      "3xl":      { "$value": "40px",    "$type": "fontSize", "$description": "2.5rem — Page header" },
      "4xl":      { "$value": "56px",    "$type": "fontSize", "$description": "3.5rem — H1 page heroes" },
      "display":  { "$value": "64px",    "$type": "fontSize", "$description": "4rem — Display, Hero home" }
    },

    "lineHeight": {
      "tight":    { "$value": 1.15, "$type": "lineHeight", "$description": "Display headings" },
      "snug":     { "$value": 1.25, "$type": "lineHeight", "$description": "Card titles, compact headings" },
      "normal":   { "$value": 1.4,  "$type": "lineHeight", "$description": "UI text, buttons" },
      "relaxed":  { "$value": 1.55, "$type": "lineHeight", "$description": "Body text, description copy" },
      "loose":    { "$value": 1.7,  "$type": "lineHeight", "$description": "Section subtitles, long-form" }
    },

    "letterSpacing": {
      "tight":   { "$value": "-0.025em", "$type": "letterSpacing", "$description": "Display and H1 headings" },
      "snug":    { "$value": "-0.02em",  "$type": "letterSpacing", "$description": "Section headings H2" },
      "normal":  { "$value": "0",        "$type": "letterSpacing", "$description": "Default body" },
      "wide":    { "$value": "0.05em",   "$type": "letterSpacing", "$description": "Badge text" },
      "wider":   { "$value": "0.07em",   "$type": "letterSpacing", "$description": "Table headers" },
      "widest":  { "$value": "0.12em",   "$type": "letterSpacing", "$description": "Eyebrow labels, micro uppercase" }
    },

    "style": {
      "$description": "Composite typography tokens — ready-to-apply text styles",

      "display": {
        "$value": {
          "fontFamily": "Plus Jakarta Sans",
          "fontWeight": 800,
          "fontSize": "clamp(2.2rem, 6vw, 4rem)",
