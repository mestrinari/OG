    "$description": "Box shadow tokens — all use blue-tinted rgba shadows",
    "xs":          { "$value": "0 1px 4px rgba(29,78,216,0.08)",                                                                         "$type": "shadow" },
    "sm":          { "$value": "0 2px 8px rgba(29,78,216,0.10)",                                                                         "$type": "shadow", "$description": "Default button shadow" },
    "card":        { "$value": "0 4px 16px rgba(29,78,216,0.08)",                                                                        "$type": "shadow", "$description": "Card resting state" },
    "card-hover":  { "$value": "0 10px 36px rgba(29,78,216,0.12)",                                                                       "$type": "shadow", "$description": "Card hover state" },
    "xl":          { "$value": "0 12px 40px rgba(29,78,216,0.14)",                                                                       "$type": "shadow" },
    "modal":       { "$value": "0 32px 80px rgba(10,18,50,0.35)",                                                                        "$type": "shadow", "$description": "QuizModal" },
    "floating":    { "$value": "0 4px 16px rgba(245,158,11,0.35)",                                                                       "$type": "shadow", "$description": "FloatingQuizBtn resting" },
    "floating-hover": { "$value": "0 6px 24px rgba(245,158,11,0.45)",                                                                    "$type": "shadow", "$description": "FloatingQuizBtn hover" },
    "amber-pulse": { "$value": "0 4px 24px rgba(245,158,11,0.4), 0 0 0 8px rgba(245,158,11,0)",                                         "$type": "shadow", "$description": "FloatingQuizBtn pulse animation (50% keyframe)" },
    "blue-focus":  { "$value": "0 0 0 3px rgba(37,99,235,0.12)",                                                                         "$type": "shadow", "$description": "Input focus ring" },
    "blue-glow":   { "$value": "0 0 0 4px rgba(37,99,235,0.12), 0 12px 40px rgba(29,78,216,0.12)",                                      "$type": "shadow", "$description": "ServiceCard selected state" },
    "selected-cyan": { "$value": "0 0 0 4px rgba(8,145,178,0.12), 0 12px 40px rgba(8,145,178,0.12)",                                    "$type": "shadow", "$description": "Mobile ServiceCard selected" },
    "selected-purple": { "$value": "0 0 0 4px rgba(124,58,237,0.12), 0 12px 40px rgba(124,58,237,0.12)",                               "$type": "shadow", "$description": "Software ServiceCard selected" },
    "selected-green": { "$value": "0 0 0 4px rgba(5,150,105,0.12), 0 12px 40px rgba(5,150,105,0.12)",                                  "$type": "shadow", "$description": "Local ServiceCard selected" }
  },

  "border": {
    "width": {
