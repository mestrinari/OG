          "fontSize": "1.05rem",
          "lineHeight": 1.3,
          "letterSpacing": "0"
        },
        "$type": "typography",
        "$description": "Card headings"
      },
      "body-large": {
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 400,
          "fontSize": "1.125rem",
          "lineHeight": 1.7,
          "letterSpacing": "0"
        },
        "$type": "typography",
        "$description": "Section subtitles"
      },
      "body": {
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 400,
          "fontSize": "1rem",
          "lineHeight": 1.6,
          "letterSpacing": "0"
        },
        "$type": "typography",
        "$description": "Default body copy"
      },
      "body-small": {
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 400,
          "fontSize": "0.875rem",
          "lineHeight": 1.6,
          "letterSpacing": "0"
        },
        "$type": "typography",
        "$description": "Card descriptions, secondary text"
      },
      "label-uppercase": {
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 700,
          "fontSize": "0.72rem",
          "lineHeight": 1.4,
          "letterSpacing": "0.1em"
        },
        "$type": "typography",
        "$description": "Eyebrows, section labels — always uppercase"
