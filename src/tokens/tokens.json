      "pill-button": {
        "$value": {
          "fontFamily": "Plus Jakarta Sans",
          "fontWeight": 700,
          "fontSize": "0.9rem",
          "lineHeight": 1.4,
          "letterSpacing": "0"
        },
        "$type": "typography",
        "$description": "FloatingQuizBtn / PillButton text"
