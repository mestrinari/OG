          "fontFamily": "Plus Jakarta Sans",
          "fontWeight": 700,
          "fontSize": "0.9rem",
          "lineHeight": 1.4,
          "letterSpacing": "0.06em"
        },
        "$type": "typography",
        "$description": "Footer column headings — uppercase"
      }
    }
  },

  "spacing": {
