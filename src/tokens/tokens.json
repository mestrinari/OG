          "letterSpacing": "0.05em"
        },
        "$type": "typography",
        "$description": "Badge/tag text — always uppercase"
      },
      "caption": {
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 400,
          "fontSize": "0.78rem",
          "lineHeight": 1.55,
          "letterSpacing": "0"
        },
        "$type": "typography",
        "$description": "Helper text, hints, captions"
      },
      "button-md": {
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 600,
          "fontSize": "0.875rem",
          "lineHeight": 1.4,
          "letterSpacing": "0"
        },
        "$type": "typography",
        "$description": "Button text — medium"
      },
      "button-lg": {
        "$value": {
          "fontFamily": "Inter",
          "fontWeight": 600,
